[%# The modern Ports tab (App::Netdisco::Web::PortsModern): a shell that
    share/public/modern/js/ports.js fills from /ajax/data/v2. data-nd2-columns is the
    site's port_columns (names, labels, defaults); data-nd2-filter the filter
    the tab was opened with. -%]
<div class="nd2-ports" data-nd2-ports
  data-nd2-src="[% uri_base | none %]/ajax/data/v2/devices/[% device_ip | uri %]/ports"
  data-nd2-api="[% uri_base | none %]/ajax/data/v2"
  data-nd2-device="[% device_ip | html_entity %]"
  data-nd2-device-name="[% device_name | html_entity %]"
  data-nd2-view="[% view_defaults | html_entity %]"
  data-nd2-model="[% model | html_entity %]"
  data-nd2-reasons="[% reasons | html_entity %]"
  data-nd2-filter="[% port_filter | html_entity %]"
  data-nd2-columns="[% columns | html_entity %]">

  <div class="nd2-toolbar" role="search">
    <label class="nd2-filter">
      <i class="fas fa-magnifying-glass" aria-hidden="true"></i>
      <input class="nd2-ports-search" type="search" autocomplete="off"
        placeholder="Filter by port, name, VLAN, MAC, neighbor…" aria-label="Filter ports">
      <kbd class="nd2-kbd" aria-hidden="true">F</kbd>
    </label>
    <div class="nd2-chips" role="group" aria-label="Show only">
      [% FOREACH chip IN [ ['up', 'Up'], ['down', 'Down'], ['disabled', 'Disabled'], ['issues', 'Issues'],
                           ['nodes', 'Has nodes'], ['neighbors', 'Neighbors'], ['poe', 'PoE'], ['free', 'Free'] ] %]
      <button type="button" class="nd2-chip" data-chip="[% chip.0 | html_entity %]" aria-pressed="false">[% chip.1 | html_entity %]</button>
      [% END %]
    </div>
    <div class="nd2-toolbar-end">
      [%# the classic sidebar's display options -%]
      <div class="dropdown">
        <button type="button" class="btn btn-outline-secondary btn-sm dropdown-toggle"
          data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false">
          <i class="fas fa-sliders" aria-hidden="true"></i> View
        </button>
        <div class="dropdown-menu dropdown-menu-end nd2-colpick nd2-viewmenu">
          <label title="Include the ports the hide_deviceports setting hides">
            <input type="checkbox" class="nd2-ports-hidden"> Hidden ports</label>
          <label><input type="checkbox" data-nd2-view="foldSubinterfaces"> Fold subinterfaces
            <span class="nd2-muted nd2-view-folded"></span></label>
          <label><input type="checkbox" data-nd2-view="vlanNames"> VLAN names, not numbers</label>
          <label><input type="checkbox" data-nd2-view="hide1002"> Hide VLANs 1002–1005</label>
          <hr class="dropdown-divider">
          <div class="nd2-viewmenu-row">
            <label for="nd2-view-mac">MAC as</label>
            <select id="nd2-view-mac" class="form-select form-select-sm" data-nd2-view="macFormat">
              [% FOREACH f IN [ 'IEEE', 'Cisco', 'Microsoft', 'Sun' ] %]
              <option value="[% f | html_entity %]">[% f | html_entity %]</option>
              [% END %]
            </select>
          </div>
          <div class="nd2-viewmenu-row" title="A port that is enabled but has had no link for this long is shown as free">
            <label for="nd2-view-age">Free if down for</label>
            <span class="nd2-viewmenu-pair">
              <select id="nd2-view-age" class="form-select form-select-sm" data-nd2-view="freeAge">
                [% FOREACH n IN [1..31] %]<option value="[% n %]">[% n %]</option>[% END %]
              </select>
              <select class="form-select form-select-sm" data-nd2-view="freeUnit" aria-label="Unit">
                [% FOREACH u IN [ 'days', 'weeks', 'months', 'years' ] %]
                <option value="[% u | html_entity %]">[% u | html_entity %]</option>
                [% END %]
              </select>
            </span>
          </div>
        </div>
      </div>
      <div class="dropdown">
        <button type="button" class="btn btn-outline-secondary btn-sm dropdown-toggle"
          data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false">
          <i class="fas fa-table-columns" aria-hidden="true"></i> Columns
        </button>
        <div class="dropdown-menu dropdown-menu-end nd2-colpick">
          <div class="nd2-colpick-list"></div>
          <hr class="dropdown-divider">
          <button type="button" class="dropdown-item nd2-colpick-reset">Reset to the defaults</button>
        </div>
      </div>
    </div>
  </div>

  <section class="nd2-card nd2-fp-card" aria-label="Front panel">
    <h3>
      <button type="button" class="nd2-fp-toggle" aria-expanded="true" aria-controls="nd2-fp">
        <i class="fas fa-chevron-down" aria-hidden="true"></i> Front panel
      </button>
      <span class="nd2-fp-modes" role="group" aria-label="Color the ports by">
        <button type="button" data-mode="status" aria-pressed="true">Status</button>
        <button type="button" data-mode="vlan" aria-pressed="false">VLAN</button>
        <button type="button" data-mode="poe" aria-pressed="false">PoE</button>
        <button type="button" data-mode="nodes" aria-pressed="false">Nodes</button>
      </span>
    </h3>
    <div class="nd2-fp" id="nd2-fp">
      <div class="nd2-chassis"></div>
      <div class="nd2-fp-legend"></div>
      <p class="nd2-fp-note nd2-muted">Laid out from the port names: physical ports only, two rows, odd numbers on top. Filters dim the ports they leave out.</p>
    </div>
  </section>

  <div class="nd2-tablewrap">
    <table class="nd2-ports-table"><tbody><tr><td class="nd2-empty">Loading the ports…</td></tr></tbody></table>
  </div>
  [%# Plugin columns and external links, drawn here with the plugin's own
      template exactly as the classic tab draws them (row, device and config
      are what it has there), into an inert template that ports.js clones its
      cells from: the browser never builds markup from a string. A template
      that fails leaves its cell empty rather than the tab. -%]
  [% IF server_columns.size %]
  [% PROCESS 'externallinks.tt' %]
  <template class="nd2-server-cells">
  [% FOREACH row IN server_rows %]
    [% FOREACH config IN server_columns %]
      [% IF config.name == 'c_links' %]
    <div data-port="[% row.port | html_entity %]" data-col="c_links">[% INCLUDE external_device_port_links item = row d = device %]</div>
      [% ELSE %]
        [% NEXT UNLESS permitted_by_acl(row, config) %]
    <div data-port="[% row.port | html_entity %]" data-col="[% config.name | html_entity %]">[% TRY %][% INCLUDE "plugin/${config.name}/device_port_column.tt" %][% CATCH %][% CLEAR %][% END %]</div>
      [% END %]
    [% END %]
  [% END %]
  </template>
  [% END %]
  <div class="nd2-tablefoot" aria-live="polite"><span class="nd2-ports-count"></span><span class="nd2-hint">Select a port for its details and controls</span></div>
</div>
