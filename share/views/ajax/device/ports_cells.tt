[%# The Ports cells that Template Toolkit still draws, because a site or a
    plugin may have written them: the external links, and each plugin
    column that brings its own device_port_column.tt. Nothing here is output;
    each cell is captured and handed back by port through collect(), and
    the browser places it.

    A plugin's template is given what ports.tt gave it: the row, the device,
    portname, vlans, nodes and ips, and the page's own tokens. A template that
    fails draws nothing, which collect() is not told, and the browser draws the
    column's field in its place. %]
[% PROCESS 'externallinks.tt' -%]
[% FOREACH row IN results %]
  [% SET portname = row.port %]
  [% IF want_links %]
    [% html = INCLUDE external_device_port_links item = row d = device %]
    [% CALL collect(row.port, '_links', html) %]
  [% END %]
  [% FOREACH config IN cell_cols %]
    [% NEXT UNLESS permitted_by_acl(row, config) %]
    [% TRY %]
      [% html = INCLUDE "plugin/${config.name}/device_port_column.tt" %]
      [% CALL collect(row.port, config.name, html) %]
    [% CATCH %]
      [% CLEAR %]
    [% END %]
  [% END %]
[% END %]
